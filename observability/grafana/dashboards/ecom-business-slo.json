    {
      "id": 1,
      "title": "Orders Created Rate (/min)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(orders_created_total[5m])) * 60 or vector(0)",
          "legendFormat": "Orders/min",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Payment Success Rate SLO (Target: 99.9%)",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{endpoint=~\"/api/payments.*\",status=~\"2..\"}[5m])) / (sum(rate(http_requests_total{endpoint=~\"/api/payments.*\"}[5m])) > 0)) * 100 or vector(100)",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 90,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 90
              },
              {
                "color": "orange",
                "value": 99.0
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Availability SLO (Target: 99.95%)",
