# ── Copy to .env and adjust for local development ──
# Postgres (single instance, 9 logical DBs)
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom123
POSTGRES_DB=postgres

# JWT
SECRET_KEY=super-secret-jwt-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Service URLs (internal DNS; override only for external debugging)
IDENTITY_SERVICE_URL=http://identity:8001
PRODUCT_SERVICE_URL=http://product:8002
INVENTORY_SERVICE_URL=http://inventory:8003
CART_SERVICE_URL=http://cart:8004
ORDER_SERVICE_URL=http://order:8005
PAYMENT_SERVICE_URL=http://payment:8006
SHIPPING_SERVICE_URL=http://shipping:8007
NOTIFICATION_SERVICE_URL=http://notification:8008
REVIEW_SERVICE_URL=http://review:8009

# Gateway
ENFORCE_AUTH=false
GATEWAY_PORT=8080

# ── Docker Hub / registry (Phase 2 CI) ──────────────────────────────────────
# REGISTRY is the destination namespace for build.sh --push and the value written
# into helm-charts/<svc>/values.yaml by gitops-bump.sh. Empty ⇒ build locally only.
DOCKERHUB_USERNAME=your-dockerhub-username
REGISTRY=docker.io/your-dockerhub-username
IMAGE_TAG=latest

# Build/test knobs the CI scripts read (all optional; scripts/ci/* have defaults).
# arm64 is not optional: Phase 3 schedules on Graviton
PLATFORMS=linux/amd64,linux/arm64
ECOM_IMAGE_PREFIX=ecom
ECOM_BUILD_PARALLEL=4
BUILDER_NAME=ecom-buildx
# 1 ⇒ --cache-from/--cache-to type=registry (push mode only)
ECOM_BUILD_CACHE=0
# 1 ⇒ force linux/amd64 only (fast PR loop)
SKIP_MULTIARCH=0

# Security gate (scan.sh). Gate on by default: a missing trivy binary FAILS the
# build rather than silently skipping the check.
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_IGNORE_UNFIXED=1
# gate | report
TRIVY_MODE=gate
STRICT_TOOLS=1

# GitOps bump (gitops-bump.sh). Jenkins sets these from credentials; locally you
# normally want DRY_RUN=1.
GITOPS_BRANCH=gitops/main
GITOPS_BASE=main
# 1 ⇒ print commands instead of running them (gitops-bump, build)
DRY_RUN=0
