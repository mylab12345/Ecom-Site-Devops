# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local

# Docker / buildx
# (`.dockerignore` files are deliberately NOT ignored: each services/<name>/
#  .dockerignore is part of the build contract and must be reviewable in git.)
.docker/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
crash.log

# K8s / Helm
*.kubeconfig

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs
logs/
*.log

# Volumes
postgres_data/
redis_data/
rabbitmq_data/

# Phase 2 CI artifacts (JUnit, trivy reports, build logs, image manifest).
# Regenerated every run; Jenkins archives them, git must not carry them.
.ci-output/
pytest-of-*/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
